{
  "name": "autocut-studio",
  "private": true,
  "type": "module",
  "version": "1.1.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "format:check": "prettier --check \"apps/cep-panel/src/**/*.{ts,css,html}\" \"apps/cep-panel/tests/**/*.{ts,html}\" \"tools/**/*.mjs\"",
    "lint": "eslint \"apps/cep-panel/src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "build": "node tools/build/generate-metadata.mjs && node tools/build/panel.mjs",
    "preview": "node tools/build/preview.mjs",
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-extension.ps1",
    "verify": "node tools/verify/payload.mjs",
    "verify:host": "node tools/verify/host-es3.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.18.8",
    "@typescript-eslint/eslint-plugin": "^8.40.0",
    "@typescript-eslint/parser": "^8.40.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.35.0",
    "espree": "^10.4.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
